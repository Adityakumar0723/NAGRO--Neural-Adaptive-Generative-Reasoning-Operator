# ============================================
# NAGRO 4.1 - Configuration
# Fully self-built. No external API keys needed.
# ============================================

# Model Configuration (local models)
NAGRO_MODEL_PATH=models/
NAGRO_LLM_MODEL=mistral-7b-instruct-v0.3.Q4_K_M.gguf
NAGRO_IMAGE_MODEL=stabilityai/sdxl-turbo
NAGRO_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Inference Settings
NAGRO_CONTEXT_LENGTH=4096
NAGRO_MAX_TOKENS=2048
NAGRO_GPU_LAYERS=0
NAGRO_THREADS=4
NAGRO_TEMPERATURE=0.7

# Image Generation Settings
NAGRO_IMAGE_STEPS=4
NAGRO_IMAGE_WIDTH=512
NAGRO_IMAGE_HEIGHT=512

# Server Configuration
NAGRO_HOST=0.0.0.0
NAGRO_PORT=8000
NAGRO_DEBUG=true

# Security
NAGRO_SECRET_KEY=change-this-to-a-random-secret-key
