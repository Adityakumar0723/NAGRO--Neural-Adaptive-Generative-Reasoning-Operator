# ============================================
# NAGRO 4.1 - Configuration
# ============================================
# Copy this file to .env and fill in your API keys

# Primary LLM Provider (anthropic / openai / groq)
NAGRO_LLM_PROVIDER=anthropic

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI API Key (for GPT models + DALL-E image generation)
OPENAI_API_KEY=your-openai-api-key-here

# Groq API Key (for fast inference)
GROQ_API_KEY=your-groq-api-key-here

# Image Generation Provider (openai / stability / replicate)
NAGRO_IMAGE_PROVIDER=openai

# Stability AI Key (for Stable Diffusion)
STABILITY_API_KEY=your-stability-api-key-here

# Replicate API Key
REPLICATE_API_KEY=your-replicate-api-key-here

# Web Search (serper.dev for Google Search)
SERPER_API_KEY=your-serper-api-key-here

# Server Configuration
NAGRO_HOST=0.0.0.0
NAGRO_PORT=8000
NAGRO_DEBUG=true

# Security
NAGRO_SECRET_KEY=change-this-to-a-random-secret-key
NAGRO_API_KEY=your-nagro-api-key-here

# Rate Limiting
NAGRO_RATE_LIMIT=60
NAGRO_RATE_WINDOW=60
