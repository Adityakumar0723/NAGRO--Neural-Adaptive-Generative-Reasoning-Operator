# ============================================
# NAGRO 4.1 - Configuration
# 100% self-built. No external AI models.
# No PyTorch. No Transformers. No HuggingFace.
# NAGRO's own engine. Zero borrowed intelligence.
# ============================================

# Context & Generation — 200K context
NAGRO_CONTEXT_LENGTH=200000
NAGRO_MAX_TOKENS=16384
NAGRO_TEMPERATURE=0.7
NAGRO_TOP_P=0.9
NAGRO_TOP_K=40
NAGRO_REPEAT_PENALTY=1.1

# Image Generation (NAGRO's own procedural engine)
NAGRO_IMAGE_STEPS=4
NAGRO_IMAGE_WIDTH=1024
NAGRO_IMAGE_HEIGHT=1024

# Server Configuration
NAGRO_HOST=0.0.0.0
NAGRO_PORT=8000
NAGRO_DEBUG=true
NAGRO_MAX_UPLOAD_MB=100

# Security
NAGRO_SECRET_KEY=change-this-to-a-random-secret-key
