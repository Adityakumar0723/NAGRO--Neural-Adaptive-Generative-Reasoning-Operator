# ============================================
# NAGRO 4.1 - Configuration
# Fully self-built. No external API keys needed.
# ============================================

# Model Configuration (local models)
NAGRO_MODEL_PATH=models/
NAGRO_LLM_MODEL=mistral-7b-instruct-v0.3.Q4_K_M.gguf
NAGRO_IMAGE_MODEL=stabilityai/sdxl-turbo
NAGRO_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Context & Generation — 200K context (Opus 5.5 level)
NAGRO_CONTEXT_LENGTH=200000
NAGRO_MAX_TOKENS=16384
NAGRO_BATCH_SIZE=512
NAGRO_TEMPERATURE=0.7
NAGRO_TOP_P=0.9
NAGRO_TOP_K=40
NAGRO_REPEAT_PENALTY=1.1

# GPU Acceleration (set > 0 if you have a GPU)
NAGRO_GPU_LAYERS=0
NAGRO_THREADS=4

# Image Generation Settings
NAGRO_IMAGE_STEPS=4
NAGRO_IMAGE_WIDTH=1024
NAGRO_IMAGE_HEIGHT=1024

# Server Configuration
NAGRO_HOST=0.0.0.0
NAGRO_PORT=8000
NAGRO_DEBUG=true
NAGRO_MAX_UPLOAD_MB=100

# Security
NAGRO_SECRET_KEY=change-this-to-a-random-secret-key
